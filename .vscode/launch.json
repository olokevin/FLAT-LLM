        {
            "name": "flatllm pruning",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "env": {
                "CUDA_VISIBLE_DEVICES": "1"
            },
            "args": [
                "--model", "meta-llama/Llama-2-7b-hf",
                "--bi_score", "ranks/wikitext2/llama-2-7b/",
                "--save", "out/llama_7b/structured/",
                "--save_model", "out_models/llama-2-7b/Llama-2-7b-hf_88",

                "--prune_method", "flatllm",
                "--sparsity_ratio", "88",
                "--dataset", "wikitext2",
                "--tol", "0.96",
                "--nsamples", "256",
                "--seed", "42",
                "--eval_zero_shot"
            ]
        }
    ]
}